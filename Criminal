local lastWarn = 0
local function safeConnect(signal, fn)
	return signal:Connect(function(...)
		local ok, err = pcall(fn, ...)
		if not ok and os.clock() - lastWarn > 2 then
			lastWarn = os.clock()
			warn("[CrimeCityPanel] " .. tostring(err))
		end
	end)
end

local function getHumanoid()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function containsAny(str, list)
	local lowered = string.lower(str)
	for _, key in ipairs(list) do
		if string.find(str, key, 1, true) or string.find(lowered, key, 1, true) then
			return true
		end
	end
	return false
end

local function relName(inst, root)
	local parts = {}
	local cur = inst
	while cur and cur ~= root do
		parts[#parts + 1] = cur.Name
		cur = cur.Parent
	end
	return table.concat(parts, "/")
end

local function partOf(obj)
	if obj:IsA("BasePart") then
		return obj
	elseif obj:IsA("Model") then
		return obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart", true)
	elseif obj:IsA("Tool") then
		return obj:FindFirstChild("Handle")
	end
	return nil
end

