local function rebuildPlayerList()
	for _, c in ipairs(playerList:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local others = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			others[#others + 1] = p
		end
	end
	table.sort(others, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)
	if #others == 0 then
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 24),
			BackgroundTransparency = 1,
			Text = "Других игроков нет",
			TextColor3 = C.sub,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			Parent = playerList,
		})
		return
	end
	for i, p in ipairs(others) do
		local b = new("TextButton", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = C.card,
			Text = p.DisplayName .. "  (@" .. p.Name .. ")",
			TextColor3 = C.text,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			AutoButtonColor = true,
			LayoutOrder = i,
			Parent = playerList,
		}, { corner(10) })
		b.Activated:Connect(function()
			local targetRoot = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if targetRoot then
				if teleportTo(targetRoot.CFrame + Vector3.new(0, 4, 0)) then
					notify("Телепорт к " .. p.DisplayName)
				end
			else
				notify("У игрока нет персонажа")
			end
		end)
	end
end
rebuildPlayerList()
