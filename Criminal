-- Телепорт по клику / тапу
do
	local pressed = {}
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not State.ClickTP.On or not isPointer(input) then
			return
		end
		pressed[input] = { pos = Vector2.new(input.Position.X, input.Position.Y), t = os.clock() }
	end)
	UserInputService.InputEnded:Connect(function(input)
		local s = pressed[input]
		if not s then return end
		pressed[input] = nil
		if not State.ClickTP.On then return end
		local endPos = Vector2.new(input.Position.X, input.Position.Y)
		if os.clock() - s.t > 0.3 or (endPos - s.pos).Magnitude > 10 then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			if not (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
				return
			end
		end
		teleportToScreenPoint(endPos)
	end)
end

