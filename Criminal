local function teleportTo(cf)
	local char, root = player.Character, getRoot()
	if not (char and root) then
		notify("Персонаж не найден")
		return false
	end
	char:PivotTo(cf)
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function nearestOf(objects)
	local root = getRoot()
	if not root then
		return nil
	end
	local best, bestDist
	for obj in pairs(objects) do
		local part = partOf(obj)
		if part and part.Parent then
			local d = (part.Position - root.Position).Magnitude
			if not bestDist or d < bestDist then
				best, bestDist = part, d
			end
		end
	end
	return best, bestDist
end

local function teleportToScreenPoint(pos)
	local cam, char, root = Workspace.CurrentCamera, player.Character, getRoot()
	if not (cam and char and root) then
		return
	end
	local ray = cam:ScreenPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local res = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
	if res then
		teleportTo(CFrame.new(res.Position + Vector3.new(0, 3.5, 0)) * root.CFrame.Rotation)
	end
end

