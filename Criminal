local ESP_MAX_HIGHLIGHTS = 30 -- лимит Roblox: 31 одновременная подсветка
local espEntries = {}

local function buildDesired()
	local desired = {}

	if State.ESPPlayers.On then
		for _, p in ipairs(Players:GetPlayers()) do
			local char = p.Character
			if p ~= player and char and char.Parent then
				desired[char] = {
					kind = "player",
					name = p.DisplayName,
					color = if p.Team then p.TeamColor.Color else CONFIG.Colors.Player,
				}
			end
		end
	end

	if State.ESPNPC.On then
		for o in pairs(collectNpcs()) do
			desired[o] = { kind = "npc", name = o.Name, color = CONFIG.Colors.Npc }
		end
	end

	if State.ESPLoot.On then
		for o in pairs(collectLoot()) do
			desired[o] = { kind = "loot", name = o.Name, color = CONFIG.Colors.Loot }
		end
	end

	return desired
end

local function createEntry(obj, part, info)
	local hl = new("Highlight", {
		Name = "CC_ESP",
		Adornee = obj:IsA("Tool") and part or obj,
		FillColor = info.color,
		OutlineColor = C.white,
		FillTransparency = 0.65,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		Enabled = false,
		Parent = espFolder,
	})
	local bb = new("BillboardGui", {
		Name = "CC_Label",
		Adornee = part,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(180, 20),
		StudsOffset = Vector3.new(0, 3, 0),
		ResetOnSpawn = false,
		Enabled = false,
		Parent = espFolder,
	})
	local label = new("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = info.name,
		TextColor3 = info.color,
		TextStrokeTransparency = 0.4,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		Parent = bb,
	})
	return { hl = hl, bb = bb, label = label, part = part, name = info.name, dist = 0 }
end

local function destroyEntry(e)
	e.hl:Destroy()
	e.bb:Destroy()
end

local function updateESP()
	local anyOn = State.ESPPlayers.On or State.ESPNPC.On or State.ESPLoot.On
	if not anyOn then
		for obj, e in pairs(espEntries) do
			destroyEntry(e)
			espEntries[obj] = nil
		end
		return
	end

	local desired = buildDesired()

	for obj, e in pairs(espEntries) do
		if not desired[obj] or not obj.Parent then
			destroyEntry(e)
			espEntries[obj] = nil
		end
	end

	local cam = Workspace.CurrentCamera
	local root = getRoot()
	local origin = if root then root.Position elseif cam then cam.CFrame.Position else Vector3.zero

	local visible = {}
	for obj, info in pairs(desired) do
		local part = partOf(obj)
		local e = espEntries[obj]
		if part and part.Parent then
			if not e then
				e = createEntry(obj, part, info)
				espEntries[obj] = e
			end
			if e.part ~= part then
				e.part = part
				e.bb.Adornee = part
			end
			e.name = info.name
			e.hl.FillColor = info.color
			e.label.TextColor3 = info.color
			e.dist = (part.Position - origin).Magnitude
			if e.dist <= State.ESPRange.Value then
				visible[#visible + 1] = e
			else
				e.hl.Enabled = false
				e.bb.Enabled = false
			end
		elseif e then
			e.hl.Enabled = false
			e.bb.Enabled = false
		end
	end

	table.sort(visible, function(a, b)
		return a.dist < b.dist
	end)
	for i, e in ipairs(visible) do
		e.bb.Enabled = true
		e.hl.Enabled = i <= ESP_MAX_HIGHLIGHTS
		e.label.Text = e.name .. "  " .. math.floor(e.dist) .. "m"
	end
end

