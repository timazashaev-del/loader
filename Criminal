local fps, fpsFrames, fpsTime = 60, 0, 0

safeConnect(RunService.Stepped, function()
	applyOverrides()
end)

safeConnect(RunService.RenderStepped, function(dt)
	updateFly(dt)
	fpsFrames += 1
	fpsTime += dt
	if fpsTime >= 0.5 then
		fps = math.floor(fpsFrames / fpsTime + 0.5)
		fpsFrames, fpsTime = 0, 0
	end
end)

safeConnect(RunService.Heartbeat, function()
	if State.Stamina.On or State.PetStamina.On then
		local now = os.clock()
		if now - lastScan > 1 then
			lastScan = now
			rescanStamina()
		end
		if State.Stamina.On then enforce(staminaTargets.General) end
		if State.PetStamina.On then enforce(staminaTargets.Pet) end
	end
end)

task.spawn(function()
	while gui.Parent do
		local ok, err = pcall(updateESP)
		if not ok and os.clock() - lastWarn > 2 then
			lastWarn = os.clock()
			warn("[CrimeCityPanel] ESP: " .. tostring(err))
		end
		task.wait(0.2)
	end
end)

task.spawn(function()
	while gui.Parent do
		local mount = currentMount()
		if mount then
			statusLabel.Text = "Питомец: " .. mount.Name .. "  •  " .. fps .. " FPS"
			statusLabel.TextColor3 = C.on
		else
			statusLabel.Text = "Питомец: не найден  •  " .. fps .. " FPS"
			statusLabel.TextColor3 = C.sub
		end
		task.wait(0.3)
	end
end)

