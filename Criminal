local function detectMount()
	local char = player.Character
	local hum = getHumanoid()
	local root = getRoot()
	if not (char and hum and root) then
		return nil
	end

	if CONFIG.CustomGetMount then
		local ok, model = pcall(CONFIG.CustomGetMount, player, char)
		if ok and typeof(model) == "Instance" then
			return model
		end
	end

	local seat = hum.SeatPart
	if seat then
		local model = seat:FindFirstAncestorOfClass("Model")
		if model and model ~= char then
			return model
		end
	end

	for _, joint in ipairs(root:GetJoints()) do
		local other
		if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
			other = (joint.Part0 == root) and joint.Part1 or joint.Part0
		end
		if other and not other:IsDescendantOf(char) then
			local model = other:FindFirstAncestorOfClass("Model")
			if model and model ~= char and not Players:GetPlayerFromCharacter(model) then
				return model
			end
		end
	end

	return nil
end

local mountCache, lastMountCheck = nil, 0
local function currentMount()
	local now = os.clock()
	if now - lastMountCheck > 0.2 then
		lastMountCheck = now
		mountCache = detectMount()
	end
	if mountCache and not mountCache.Parent then
		mountCache = nil
	end
	return mountCache
end

--------------------------------------------------------------------
-- ПЕРЕОПРЕДЕЛЕНИЕ СВОЙСТВ (с автоматическим возвратом оригиналов)
--------------------------------------------------------------------
local saved = {} -- [Instance] = { [key] = { orig = value, frame = n } }
local frameId = 0

local function readProp(inst, key)
	if string.sub(key, 1, 1) == "@" then
		return inst:GetAttribute(string.sub(key, 2))
	end
	return inst[key]
end

local function writeProp(inst, key, value)
	if string.sub(key, 1, 1) == "@" then
		inst:SetAttribute(string.sub(key, 2), value)
	else
		inst[key] = value
	end
end

local function force(inst, key, value)
	local s = saved[inst]
	if not s then
		s = {}
		saved[inst] = s
	end
	local e = s[key]
	if not e then
		s[key] = { orig = readProp(inst, key), frame = frameId }
	else
		e.frame = frameId
	end
	if readProp(inst, key) ~= value then
		writeProp(inst, key, value)
	end
end

local function releaseStale()
	for inst, props in pairs(saved) do
		for key, e in pairs(props) do
			if e.frame ~= frameId then
				if inst.Parent then
					pcall(writeProp, inst, key, e.orig)
				end
				props[key] = nil
			end
		end
		if next(props) == nil then
			saved[inst] = nil
		end
	end
	frameId += 1
end

local speedCache = { mount = nil, at = 0, list = {} }
local function getPetSpeedTargets(mount)
	local now = os.clock()
	if speedCache.mount ~= mount or now - speedCache.at > 1 then
		speedCache.mount = mount
		speedCache.at = now
		local list = {}
		local function addAttrs(inst)
			for _, name in ipairs(CONFIG.SpeedAttributes) do
				if type(inst:GetAttribute(name)) == "number" then
					list[#list + 1] = { inst, "@" .. name }
				end
			end
		end
		addAttrs(mount)
		for _, d in ipairs(mount:GetDescendants()) do
			if d:IsA("Humanoid") then
				list[#list + 1] = { d, "WalkSpeed" }
				addAttrs(d)
			elseif d:IsA("VehicleSeat") then
				list[#list + 1] = { d, "MaxSpeed" }
				addAttrs(d)
			end
		end
		speedCache.list = list
	end
	return speedCache.list
end

-- части тела для NoClip (персонаж + питомец)
local partCache, partCacheAt, partCacheChar, partCacheMount = {}, 0, nil, nil
local function getCollidableParts()
	local char = player.Character
	local mount = currentMount()
	local now = os.clock()
	if char ~= partCacheChar or mount ~= partCacheMount or now - partCacheAt > 0.3 then
		partCacheChar, partCacheMount, partCacheAt = char, mount, now
		table.clear(partCache)
		for _, root in ipairs({ char, mount }) do
			if root then
				for _, d in ipairs(root:GetDescendants()) do
					if d:IsA("BasePart") then
						partCache[#partCache + 1] = d
					end
				end
			end
		end
	end
	return partCache
end

local function applyOverrides()
	local hum = getHumanoid()
	if hum and hum.Health > 0 then
		local mount = currentMount()
		if mount and State.Pet.On then
			force(hum, "WalkSpeed", State.Pet.Value)
			for _, t in ipairs(getPetSpeedTargets(mount)) do
				if t[1].Parent then
					force(t[1], t[2], State.Pet.Value)
				end
			end
		elseif State.Walk.On then
			force(hum, "WalkSpeed", State.Walk.Value)
		end

		if State.Jump.On then
			if hum.UseJumpPower then
				force(hum, "JumpPower", State.Jump.Value)
			else
				force(hum, "JumpHeight", (State.Jump.Value ^ 2) / (2 * Workspace.Gravity))
			end
		end

		if State.NoClip.On then
			for _, part in ipairs(getCollidableParts()) do
				if part.Parent then
					force(part, "CanCollide", false)
				end
			end
		end
	end

	local cam = Workspace.CurrentCamera
	if State.FOV.On and cam then
		force(cam, "FieldOfView", State.FOV.Value)
	end

	if State.Fullbright.On then
		force(Lighting, "Brightness", 2)
		force(Lighting, "ClockTime", 14)
		force(Lighting, "FogEnd", 1e6)
		force(Lighting, "GlobalShadows", false)
		force(Lighting, "Ambient", Color3.fromRGB(178, 178, 178))
		force(Lighting, "OutdoorAmbient", Color3.fromRGB(178, 178, 178))
	end

	releaseStale()
end

