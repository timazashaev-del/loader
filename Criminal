local npcSet = setmetatable({}, { __mode = "k" })
local lootSet = setmetatable({}, { __mode = "k" })
local worldHooked = false

local function considerInstance(inst)
	if inst:IsA("Humanoid") then
		local model = inst.Parent
		if model and model:IsA("Model") then
			npcSet[model] = true
		end
	elseif inst:IsA("Tool") then
		lootSet[inst] = true
	end
end

local function ensureWorldScan()
	if worldHooked then
		return
	end
	worldHooked = true
	Workspace.DescendantAdded:Connect(considerInstance)
	Workspace.DescendantRemoving:Connect(function(inst)
		npcSet[inst] = nil
		lootSet[inst] = nil
	end)
	task.spawn(function()
		local n = 0
		for _, d in ipairs(Workspace:GetDescendants()) do
			considerInstance(d)
			n += 1
			if n % 4000 == 0 then
				task.wait()
			end
		end
	end)
end

local function isValidNpc(model)
	if not model.Parent or model == player.Character or model == currentMount() then
		return false
	end
	if Players:GetPlayerFromCharacter(model) then
		return false
	end
	local h = model:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end

local function isValidLoot(tool)
	local p = tool.Parent
	if not p or p:IsA("Backpack") then
		return false
	end
	if p:FindFirstChildOfClass("Humanoid") then
		return false -- предмет в руках персонажа/NPC
	end
	return true
end

-- возвращает { [объект] = true }
local function collectNpcs()
	local out = {}
	for _, o in ipairs(CollectionService:GetTagged(CONFIG.NpcTag)) do
		if o.Parent and o ~= player.Character then
			out[o] = true
		end
	end
	if CONFIG.AutoDetectNPC then
		ensureWorldScan()
		for model in pairs(npcSet) do
			if isValidNpc(model) then
				out[model] = true
			end
		end
	end
	return out
end

local function collectLoot()
	local out = {}
	for _, o in ipairs(CollectionService:GetTagged(CONFIG.LootTag)) do
		if o.Parent then
			out[o] = true
		end
	end
	if CONFIG.AutoDetectLoot then
		ensureWorldScan()
		for tool in pairs(lootSet) do
			if isValidLoot(tool) then
				out[tool] = true
			end
		end
	end
	return out
end

