do
	local cam = Workspace.CurrentCamera
	if cam then
		cam:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(updateScale)
end

