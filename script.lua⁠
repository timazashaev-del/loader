local function stopFly()
    State.Fly = false
    mobileControls.Visible = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    _, humanoid, root = getChar()
    if root then
        local velocity = root:FindFirstChild("CC_FlyVelocity")
        local gyro = root:FindFirstChild("CC_FlyGyro")
        if velocity then velocity:Destroy() end
        if gyro then gyro:Destroy() end
    end

    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function startFly()
    stopFly()
    local _, humanoid, root = getChar()
    if not root or not humanoid then return end

    State.Fly = true
    mobileControls.Visible = true

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "CC_FlyVelocity"
    velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    velocity.Velocity = Vector3.zero
    velocity.Parent = root

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "CC_FlyGyro"
    gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    gyro.Parent = root

    humanoid.PlatformStand = true

    flyConnection = RunService.RenderStepped:Connect(function()
        local _, _, currentRoot = getChar()
        if not State.Fly or not currentRoot or not currentRoot.Parent then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera
        local direction = Vector3.zero

        if forwardHeld or UIS:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end
        if UIS:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end

        if upHeld or UIS:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.yAxis
        end
        if downHeld or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.yAxis
        end

        velocity.Velocity = direction.Magnitude > 0
            and direction.Unit * SETTINGS.FlySpeed
            or Vector3.zero

        gyro.CFrame = camera.CFrame
    end)
end

toggle("Полёт (Fly)", "Fly", function(enabled)
    if enabled then startFly() else stopFly() end
end)

-- ESP
local function clearESP()
    for object, highlight in pairs(highlights) do
        if highlight then highlight:Destroy() end
        highlights[object] = nil
    end
end

local function addESP(object, color)
    local char = player.Character
    if not object or object == char then return end
    if highlights[object] then return end

    if not object:IsA("Model") and not object:IsA("BasePart") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = "CC_ESP"
    h.Adornee = object
    h.FillColor = color
    h.OutlineColor = Color3.new(1, 1, 1)
    h.FillTransparency = 0.65
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = gui

    highlights[object] = h
end

local function updateESP()
    clearESP()

    if State.ESPPlayers then
        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= player and target.Character then
                addESP(target.Character, Color3.fromRGB(50, 150, 255))
            end
        end
    end

    if State.ESPNPC then
        for _, object in ipairs(CollectionService:GetTagged("CrimeNPC")) do
            addESP(object, Color3.fromRGB(255, 60, 60))
        end
    end

    if State.ESPLoot then
        for _, object in ipairs(CollectionService:GetTagged("CrimeLoot")) do
            addESP(object, Color3.fromRGB(60, 255, 100))
        end
    end
end

toggle("ESP игроков", "ESPPlayers", updateESP)
