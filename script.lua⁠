-- Мобильная панель тестирования для Delta Android
local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Безопасное определение родителя для GUI (чтобы не пропадало после смерти)
local guiParent = nil
pcall(function()
	guiParent = gethui()
end)
if not guiParent then
	pcall(function()
		guiParent = CoreGui
	end)
end
if not guiParent then
	guiParent = playerGui
end

-- Удаляем старую копию меню, если она уже запущена
if guiParent:FindFirstChild("StudioTestMenu") then
	guiParent.StudioTestMenu:Destroy()
end

local state = {
	fly = false,
	noclip = false,
	ghost = false,
	god = false,
	esp = false,
	vertical = 0,
	speedIndex = 1,
	jumpIndex = 1,
}

local speeds = {16, 24, 32, 48}
local jumps = {50, 70, 90, 110}
local savedCollisions = {}
local savedTransparency = {}
local highlights = {}
local flyVelocity
local flyAttachment
local humanoid
local root
local savedMaxHealth

local function getCharacter()
	local character = player.Character
	if not character then return nil end

	humanoid = character:FindFirstChildOfClass("Humanoid")
	root = character:FindFirstChild("HumanoidRootPart")
	return character
end

local function round(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = parent
end

local gui = Instance.new("ScreenGui")
gui.Name = "StudioTestMenu"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = guiParent

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Size = UDim2.fromOffset(250, 390)
panel.Position = UDim2.new(0.5, -125, 0.5, -195)
panel.BackgroundColor3 = Color3.fromRGB(24, 27, 35)
panel.BorderSizePixel = 0
panel.Parent = gui
round(panel, 14)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -48, 0, 42)
title.Position = UDim2.fromOffset(14, 4)
title.BackgroundTransparency = 1
title.Text = "DELTA TEST MENU"
title.TextColor3 = Color3.fromRGB(245, 247, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 15
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

local hide = Instance.new("TextButton")
hide.Size = UDim2.fromOffset(32, 30)
hide.Position = UDim2.new(1, -40, 0, 8)
hide.BackgroundColor3 = Color3.fromRGB(190, 65, 75)
hide.Text = "×"
hide.TextColor3 = Color3.new(1, 1, 1)
hide.Font = Enum.Font.GothamBold
hide.TextSize = 20
hide.Parent = panel
round(hide, 8)

local list = Instance.new("ScrollingFrame")
list.Size = UDim2.new(1, -20, 1, -58)
list.Position = UDim2.fromOffset(10, 50)
list.BackgroundTransparency = 1
list.BorderSizePixel = 0
list.ScrollBarThickness = 4
list.AutomaticCanvasSize = Enum.AutomaticSize.Y
list.CanvasSize = UDim2.new()
list.Parent = panel

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = list

local function makeButton(text, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -8, 0, 42)
	button.BackgroundColor3 = Color3.fromRGB(54, 68, 96)
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.Font = Enum.Font.GothamSemibold
	button.TextSize = 14
	button.AutoButtonColor = true
	button.Parent = list
	round(button, 9)
	button.Activated:Connect(callback)
	return button
end

local function refreshButton(button, label, enabled)
	button.Text = label .. (enabled and "  •  ON" or "  •  OFF")
	button.BackgroundColor3 = enabled
		and Color3.fromRGB(40, 145, 105)
		or Color3.fromRGB(54, 68, 96)
end

local function stopFly()
	if flyVelocity then
		flyVelocity:Destroy()
		flyVelocity = nil
	end
	if flyAttachment then
		flyAttachment:Destroy()
		flyAttachment = nil
	end
	if humanoid then
		humanoid.PlatformStand = false
	end
end

local function startFly()
	local character = getCharacter()
	if not character or not root then return end

	stopFly()

	flyAttachment = Instance.new("Attachment")
	flyAttachment.Name = "StudioFlyAttachment"
	flyAttachment.Parent = root

	flyVelocity = Instance.new("LinearVelocity")
	flyVelocity.Name = "StudioFlyVelocity"
	flyVelocity.Attachment0 = flyAttachment
	flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	flyVelocity.VectorVelocity = Vector3.zero
	flyVelocity.MaxForce = 100000
	flyVelocity.Parent = root
end

local function setFly(enabled)
	state.fly = enabled
	if enabled then
		startFly()
	else
		stopFly()
	end
end

local function setGhost(enabled)
	state.ghost = enabled
	local character = getCharacter()
	if not character then return end

	if enabled then
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BasePart") then
				if savedTransparency[object] == nil then
					savedTransparency[object] = object.LocalTransparencyModifier
				end
				object.LocalTransparencyModifier = 0.75
			end
		end
	else
		for part, value in pairs(savedTransparency) do
			if part and part.Parent then
				part.LocalTransparencyModifier = value
			end
		end
		table.clear(savedTransparency)
	end
end

local function setNoclip(enabled)
	state.noclip = enabled
	if not enabled then
		for part, value in pairs(savedCollisions) do
			if part and part.Parent then
				part.CanCollide = value
			end
		end
		table.clear(savedCollisions)
	end
end

local function clearESP()
	for model, highlight in pairs(highlights) do
		if highlight then highlight:Destroy() end
		highlights[model] = nil
	end
end

local keywords = {
	"diamond", "gem", "loot", "item", "cash", "money",
	"safe", "police", "guard", "citizen", "npc",
}

local function matchesName(name)
	name = string.lower(name)
	for _, word in ipairs(keywords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end
	return false
end

local function refreshESP()
	clearESP()
	if not state.esp then return end

	for _, object in ipairs(workspace:GetDescendants()) do
		if object:IsA("Model") and object ~= player.Character and matchesName(object.Name) then
			local highlight = Instance.new("Highlight")
			highlight.Name = "StudioTestHighlight"
			highlight.Adornee = object
			highlight.FillColor = Color3.fromRGB(60, 220, 160)
			highlight.OutlineColor = Color3.fromRGB(230, 255, 245)
			highlight.FillTransparency = 0.65
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = gui
			highlights[object] = highlight
		end
	end
end

local flyButton
flyButton = makeButton("Полёт  •  OFF", function()
	setFly(not state.fly)
	refreshButton(flyButton, "Полёт", state.fly)
end)

local upButton = makeButton("Удерживай для подъёма", function() end)
local downButton = makeButton("Удерживай для спуска", function() end)

upButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		state.vertical = 1
	end
end)
upButton.InputEnded:Connect(function()
	if state.vertical == 1 then state.vertical = 0 end
end)

downButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		state.vertical = -1
	end
end)
downButton.InputEnded:Connect(function()
	if state.vertical == -1 then state.vertical = 0 end
end)

local noclipButton
noclipButton = makeButton("Проход сквозь стены  •  OFF", function()
	setNoclip(not state.noclip)
	refreshButton(noclipButton, "Проход сквозь стены", state.noclip)
end)

local ghostButton
ghostButton = makeButton("Локальная прозрачность  •  OFF", function()
	setGhost(not state.ghost)
	refreshButton(ghostButton, "Локальная прозрачность", state.ghost)
end)

local godButton
godButton = makeButton("Тест здоровья  •  OFF", function()
	state.god = not state.god
	if humanoid then
		if state.god then
			savedMaxHealth = humanoid.MaxHealth
			humanoid.MaxHealth = 10000
			humanoid.Health = humanoid.MaxHealth
		else
			humanoid.MaxHealth = savedMaxHealth or 100
			humanoid.Health = math.min(humanoid.Health, humanoid.MaxHealth)
		end
	end
	refreshButton(godButton, "Тест здоровья", state.god)
end)

local espButton
espButton = makeButton("Метки объектов  •  OFF", function()
	state.esp = not state.esp
	refreshESP()
	refreshButton(espButton, "Метки объектов", state.esp)
end)

local speedButton
speedButton = makeButton("Скорость: 16", function()
	state.speedIndex = state.speedIndex % #speeds + 1
	if humanoid then humanoid.WalkSpeed = speeds[state.speedIndex] end
	speedButton.Text = "Скорость: " .. speeds[state.speedIndex]
end)

local jumpButton
jumpButton = makeButton("Прыжок: 50", function()
	state.jumpIndex = state.jumpIndex % #jumps + 1
	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = jumps[state.jumpIndex]
	end
	jumpButton.Text = "Прыжок: " .. jumps[state.jumpIndex]
end)

local function toggleMenu()
	panel.Visible = not panel.Visible
end

hide.Activated:Connect(toggleMenu)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.RightShift then
		toggleMenu()
	elseif input.KeyCode == Enum.KeyCode.Space and state.fly then
		state.vertical = 1
	elseif input.KeyCode == Enum.KeyCode.LeftControl and state.fly then
		state.vertical = -1
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Space and state.vertical == 1 then
		state.vertical = 0
	elseif input.KeyCode == Enum.KeyCode.LeftControl and state.vertical == -1 then
		state.vertical = 0
	end
end)

RunService.Stepped:Connect(function()
	if state.noclip then
		local character = getCharacter()
		if character then
			for _, object in ipairs(character:GetDescendants()) do
				if object:IsA("BasePart") then
					if savedCollisions[object] == nil then
						savedCollisions[object] = object.CanCollide
					end
					object.CanCollide = false
				end
			end
		end
	end
end)

RunService.Heartbeat:Connect(function()
	if not getCharacter() then return end

	if state.fly and flyVelocity and root then
		local camera = workspace.CurrentCamera
		local direction = humanoid.MoveDirection
		local vertical = state.vertical

		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1 end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then vertical = -1 end

		local cameraForward = camera and camera.CFrame.LookVector or Vector3.new(0, 0, -1)
		local horizontal = Vector3.new(direction.X, 0, direction.Z)

		if horizontal.Magnitude > 0.05 then
			horizontal = horizontal.Unit * 42
		end

		flyVelocity.VectorVelocity = horizontal + Vector3.new(0, vertical * 36, 0)
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
	end

	if state.god and humanoid then
		humanoid.Health = humanoid.MaxHealth
	end
end)

player.CharacterAdded:Connect(function()
	task.wait(0.5)
	getCharacter()

	if state.fly then startFly() end
	if state.ghost then setGhost(true) end
	if state.noclip then table.clear(savedCollisions) end

	if humanoid then
		humanoid.WalkSpeed = speeds[state.speedIndex]
		humanoid.UseJumpPower = true
		humanoid.JumpPower = jumps[state.jumpIndex]
	end

	if state.esp then
		task.wait(0.5)
		refreshESP()
	end
end)

task.spawn(function()
	while gui.Parent do
		task.wait(3)
		if state.esp then refreshESP() end
	end
end)

getCharacter()
