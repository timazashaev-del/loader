local function createButton(text, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 42)
    button.BackgroundColor3 = Color3.fromRGB(39, 45, 63)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamSemibold
    button.Text = text
    button.BorderSizePixel = 0
    button.Parent = scroll

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
    button.Activated:Connect(callback)

    return button
end

local function toggle(label, key, callback)
    local enabled = false
    local button

    button = createButton(label .. " [OFF]", function()
        enabled = not enabled
        State[key] = enabled

        button.Text = label .. (enabled and " [ON]" or " [OFF]")
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(30, 125, 85)
            or Color3.fromRGB(39, 45, 63)

        callback(enabled)
    end)

    return button
end

