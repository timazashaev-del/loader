-- ESP (Игроки, NPC, Лут)
local highlights = {}
local function clearESP()
	for obj, h in pairs(highlights) do
		if h then h:Destroy() end
		highlights[obj] = nil
	end
end

local function addESP(obj, color)
	local char = player.Character
	if not obj or obj == char or highlights[obj] then return end
	if not obj:IsA("Model") and not obj:IsA("BasePart") then return end

	local h = Instance.new("Highlight")
	h.Name = "CC_ESP"
	h.Adornee = obj
	h.FillColor = color
	h.OutlineColor = Color3.new(1, 1, 1)
	h.FillTransparency = 0.6
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = playerGui
	highlights[obj] = h
end

local function updateESP()
	clearESP()
	if State.ESPPlayers.On then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				addESP(p.Character, Color3.fromRGB(50, 150, 255))
			end
		end
	end
	if State.ESPNPC.On then
		for _, obj in ipairs(CollectionService:GetTagged("CrimeNPC")) do
			addESP(obj, Color3.fromRGB(255, 60, 60))
		end
	end
	if State.ESPLoot.On then
		for _, obj in ipairs(CollectionService:GetTagged("CrimeLoot")) do
			addESP(obj, Color3.fromRGB(60, 255, 100))
		end
	end
end

task.spawn(function()
	while true do
		task.wait(1.5)
		if State.ESPPlayers.On or State.ESPNPC.On or State.ESPLoot.On then
			pcall(updateESP)
		end
	end
end)

