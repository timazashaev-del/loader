-- Создание карточек функций
local function createCard(opts)
	local api = {}
	local isOn = false
	local currentValue

	local card = new("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = C.card,
		LayoutOrder = opts.order,
		Parent = content,
	}, {
		corner(12),
		new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }),
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local top = new("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundTransparency = 1, LayoutOrder = 1, Parent = card })
	new("TextLabel", {
		Size = UDim2.new(1, -104, 1, 0),
		BackgroundTransparency = 1,
		Text = opts.title,
		TextColor3 = C.text,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = top,
	})
	local status = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -52, 0.5, 0),
		Size = UDim2.fromOffset(36, 20),
		BackgroundTransparency = 1,
		Text = "OFF",
		TextColor3 = C.sub,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = top,
	})
	local pill = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(46, 24),
		BackgroundColor3 = C.off,
		Text = "",
		AutoButtonColor = false,
		Parent = top,
	}, { corner(12) })
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = C.white,
		Parent = pill,
	}, { corner(9) })

	function api.setOn(on, silent)
		isOn = on and true or false
		status.Text = isOn and "ON" or "OFF"
		tween(status, { TextColor3 = isOn and C.on or C.sub })
		tween(pill, { BackgroundColor3 = isOn and C.on or C.off })
		tween(knob, { Position = isOn and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
		if opts.stateRef then opts.stateRef.On = isOn end
		if not silent and opts.onToggle then opts.onToggle(isOn) end
	end
	function api.isOn() return isOn end
	pill.Activated:Connect(function() api.setOn(not isOn) end)

	if opts.slider then
		local s = opts.slider
		local group = new("Frame", { Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, LayoutOrder = 2, Parent = card })
		new("TextLabel", {
			Size = UDim2.new(1, -64, 0, 18),
			BackgroundTransparency = 1,
			Text = s.label,
			TextColor3 = C.sub,
			Font = Enum.Font.Gotham,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = group,
		})
		local box = new("TextBox", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(56, 20),
			BackgroundColor3 = C.bg,
			Text = "",
			TextColor3 = C.text,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			ClearTextOnFocus = false,
			Parent = group,
		}, { corner(6) })
		local track = new("Frame", {
			Position = UDim2.new(0, 0, 0, 28),
			Size = UDim2.new(1, 0, 0, 5),
			BackgroundColor3 = C.off,
			Parent = group,
		}, { corner(3) })
		local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = C.accent, Parent = track }, { corner(3) })
		local sKnob = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = C.white,
			Parent = track,
		}, { corner(7) })
		local hit = new("TextButton", {
			Position = UDim2.new(0, -8, 0, 18),
			Size = UDim2.new(1, 16, 0, 24),
			BackgroundTransparency = 1,
			Text = "",
			Parent = group,
		})

		function api.setValue(v, silent)
			v = math.clamp(math.floor(v + 0.5), s.min, s.max)
			currentValue = v
			local rel = (v - s.min) / (s.max - s.min)
			fill.Size = UDim2.new(rel, 0, 1, 0)
			sKnob.Position = UDim2.new(rel, 0, 0.5, 0)
			box.Text = tostring(v)
			if opts.stateRef then opts.stateRef.Value = v end
			if not silent and opts.onValue then opts.onValue(v) end
		end

		local dragging = false
		local function fromX(x)
			local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
			api.setValue(s.min + rel * (s.max - s.min))
		end
		hit.InputBegan:Connect(function(input)
			if isPointer(input) then
				dragging = true
				content.ScrollingEnabled = false
				fromX(input.Position.X)
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						content.ScrollingEnabled = true
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				fromX(input.Position.X)
			end
		end)
		box.FocusLost:Connect(function()
			local n = tonumber((box.Text:gsub("[^%d%.]", "")))
			if n then api.setValue(n) else api.setValue(currentValue) end
		end)

		api.setValue(s.default, true)
	end

	return api
end

