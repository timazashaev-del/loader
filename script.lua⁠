--==================================================
-- CRIME CITY ULTIMATE LOADER (GITHUB VERSION)
--==================================================

local success, err = pcall(function()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/timazashaev-del/loader/main/core.lua"))()
end)

if not success then
    warn("[CrimeCity Loader Error]: " .. tostring(err))
    
    -- Резервный вариант интерфейса, если основная загрузка не удалась
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
    gui.Name = "CrimeCityError"
    
    local label = Instance.new("TextLabel", gui)
    label.Size = UDim2.fromOffset(350, 60)
    label.Position = UDim2.new(0.5, -175, 0.2, 0)
    label.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Text = "Ошибка загрузки скрипта!\nПроверь имя файла core.lua на GitHub."
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 8)
end
