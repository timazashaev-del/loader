toggle("ESP предметов", "ESPLoot", updateESP)

createButton("ОБНОВИТЬ ESP", updateESP)

-- TELEPORTS
createButton("Телепорт на Spawn", function()
    local _, _, root = getChar()
    if not root then return end
    local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
    if spawn then
        root.CFrame = spawn.CFrame + Vector3.new(0, 4, 0)
    end
end)

createButton("К ближайшему предмету", function()
    local _, _, root = getChar()
    if not root then return end
    local nearest, shortest

    for _, object in ipairs(CollectionService:GetTagged("CrimeLoot")) do
        local part
        if object:IsA("BasePart") then
            part = object
        elseif object:IsA("Model") then
            part = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")
        end

        if part then
            local distance = (root.Position - part.Position).Magnitude
            if not shortest or distance < shortest then
                shortest = distance
                nearest = part
            end
        end
    end

    if nearest then
        root.CFrame = nearest.CFrame + Vector3.new(0, 4, 0)
    end
end)

